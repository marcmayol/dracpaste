# Copia este fichero a keystore.properties y rellénalo con los datos reales.
#
# keystore.properties está en el .gitignore: la contraseña de firma no se versiona nunca.
# La keystore vive fuera del repositorio, en la carpeta del usuario.
#
# Alternativa sin fichero (útil en CI): las variables de entorno
#   DRACPASTE_STORE_FILE, DRACPASTE_STORE_PASSWORD, DRACPASTE_KEY_ALIAS, DRACPASTE_KEY_PASSWORD
#
# Si no hay ni fichero ni variables, se compila con la clave de depuración: cualquiera
# puede clonar el proyecto y montar un APK, pero publicarlo así lo impide
# scripts/publicar_release.py, que aborta si el APK viene firmado con "CN=Android Debug".
#
# Cuidado al crearlo desde PowerShell: `Set-Content -Encoding utf8` escribe un BOM que
# Properties.load no entiende, y el APK acabaría firmado en depuración sin que nada avise.
# Usa [System.IO.File]::WriteAllText con UTF8Encoding($false).

storeFile=C:/Users/marcm/dracpaste-release.jks
storePassword=
keyAlias=dracpaste
keyPassword=
