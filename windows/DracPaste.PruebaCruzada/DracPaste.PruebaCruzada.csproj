<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows porque usa el servidor de la app de bandeja, que a su vez usa
         DPAPI para la identidad. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DracPaste.PruebaCruzada</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DracPaste.Bandeja\DracPaste.Bandeja.csproj" />
  </ItemGroup>

</Project>
